DirectoryIndex index-canonical.php index.html index.php
Options -Indexes

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|index\.php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<Files "config.php">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Localhost → 127 for browser GETs only. Do not redirect POST (breaks login/API curl to localhost).
  RewriteCond %{HTTP_HOST} ^localhost(:\d+)?$ [NC]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
  RewriteRule ^ http://127.0.0.1:%{SERVER_PORT}%{REQUEST_URI} [R=302,L]
  RewriteRule ^sql/ - [F,L]
</IfModule>

<FilesMatch "\.(sql|log|ini)$">
  Require all denied
</FilesMatch>
